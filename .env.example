# KrishiMitra AI - Environment Configuration
# Optional: The platform operates with built-in resilient offline-first intelligence if keys are not provided.

# Google Gemini API Key (Multimodal Vision & Agronomy Advisory)
# Obtain from: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# Firebase Configuration (Authentication, Firestore, Storage)
# Obtain from: https://console.firebase.google.com/
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: override Gemini model (see https://ai.google.dev/gemini-api/docs/models)
VITE_GEMINI_MODEL=gemini-3.6-flash

# OpenRouter (free models). If set, used instead of Gemini.
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=openrouter/free
